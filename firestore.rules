rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.role == 'admin' || request.auth.token.role == 'SUPER_ADMIN');
    }
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == 'SUPER_ADMIN';
    }
    function isClient() {
      return isAuthenticated() && currentUserData().role == 'client';
    }
    function isWorker() {
      return isAuthenticated() && currentUserData().role == 'worker';
    }
    
    // ── Validation Helpers ────────────────────────────────────────────────
    function isValidGeoPoint(point) {
      return point != null 
          && point is latlng
          // latlng exposes latitude()/longitude() as methods; reading them
          // as fields failed for every GeoPoint (Phase 4B fix).
          && point.latitude() >= -90.0 && point.latitude() <= 90.0
          && point.longitude() >= -180.0 && point.longitude() <= 180.0;
    }
    
    // Checks if the user is updating location fields safely
    // Absent, cleared (null — e.g. a job without a map pin) or a valid point.
    function isValidLocationUpdate(data) {
      return !('location' in data) || data.location == null || isValidGeoPoint(data.location);
    }

    // Roles a person may give themselves. Staff roles are set only by Admin SDK
    // tooling (custom claims), never through client writes.
    function isSelfServiceRole(role) {
      return role in ['client', 'worker'];
    }

    // Role may stay the same, or be chosen once when it is missing/empty
    // (legacy Google sign-ups stored role ''). It can never become 'admin'.
    function roleChangeAllowed() {
      let before = resource.data.get('role', '');
      let after = request.resource.data.get('role', '');
      return after == before || (before == '' && isSelfServiceRole(after));
    }

    // A suspended account cannot reactivate itself.
    function activeFlagUnchanged() {
      return request.resource.data.get('isActive', true) == resource.data.get('isActive', true);
    }

    // Owners may (re)submit for verification ('pending') but never mark
    // themselves verified or rejected.
    function workerVerificationStatusAllowed() {
      let before = resource.data.get('workerProfile', {}).get('verificationStatus', '');
      let after = request.resource.data.get('workerProfile', {}).get('verificationStatus', '');
      return after == before || after == 'pending';
    }

    // CNIC belongs in users/{uid}/private/verification. Owners may keep or
    // remove a legacy public copy, but never add or change one.
    function publicCnicNotAddedOrChanged() {
      return !('cnicNumber' in request.resource.data)
        || request.resource.data.cnicNumber == resource.data.get('cnicNumber', null);
    }

    // Verification document entries must be files in the owner's private folder.
    function isOwnVerificationPath(userId, path) {
      return path is string
        && path.matches('^users/' + userId + '/(verificationDocuments|verificationDocs)/[^/]+$');
    }

    function isProtectedProfileDataUnchanged() {
      return roleChangeAllowed()
        && activeFlagUnchanged()
        && publicCnicNotAddedOrChanged()
        && workerVerificationStatusAllowed()
        && ((!('isVerified' in request.resource.data) && !('isVerified' in resource.data))
          || (('isVerified' in request.resource.data) && ('isVerified' in resource.data)
            && request.resource.data.isVerified == resource.data.isVerified)
          || (('isVerified' in request.resource.data) && !('isVerified' in resource.data)
            && request.resource.data.isVerified == false))
        && ((!('isCnicVerified' in request.resource.data) && !('isCnicVerified' in resource.data))
          || (('isCnicVerified' in request.resource.data) && ('isCnicVerified' in resource.data)
            && request.resource.data.isCnicVerified == resource.data.isCnicVerified)
          || (('isCnicVerified' in request.resource.data) && !('isCnicVerified' in resource.data)
            && request.resource.data.isCnicVerified == false))
        // Reputation numbers are shown publicly (publicProfiles), so owners can
        // never set them: kept as stored, or (field not stored yet) only the
        // starting values (Phase S2; previously any value could be added).
        && (statKept(request.resource.data, resource.data, 'rating', 5)
            || request.resource.data.rating == myRatings().average)
        && (statKept(request.resource.data, resource.data, 'totalReviews', 0)
            || request.resource.data.totalReviews == myRatings().count)
        // A worker profile, once stored, can't be removed (that would reset
        // its stats on re-creation).
        && ((!('workerProfile' in request.resource.data) && !('workerProfile' in resource.data))
          || ((!('workerProfile' in resource.data)
              && (!('isVerified' in request.resource.data.workerProfile) || request.resource.data.workerProfile.isVerified == false)
              && startingWorkerStats(request.resource.data.workerProfile))
            || (('workerProfile' in resource.data)
              && (!('isVerified' in request.resource.data.workerProfile) || !('isVerified' in resource.data.workerProfile) || request.resource.data.workerProfile.isVerified == resource.data.workerProfile.isVerified)
              && (statKept(request.resource.data.workerProfile, resource.data.workerProfile, 'averageRating', 0)
                  || request.resource.data.workerProfile.averageRating == myRatings().average)
              && (statKept(request.resource.data.workerProfile, resource.data.workerProfile, 'totalReviews', 0)
                  || request.resource.data.workerProfile.totalReviews == myRatings().count)
              && statKept(request.resource.data.workerProfile, resource.data.workerProfile, 'totalJobsCompleted', 0))));
    }

    // The signed-in person's rating ledger (free plan, Phase S5): reviews
    // update it in checked transactions; owners copy it onto their account.
    function myRatings() {
      return get(/databases/$(database)/documents/ratings/$(request.auth.uid)).data;
    }

    // A reputation number is unchanged (and can't be removed, which would
    // let a bad rating be reset), or (not stored before) absent or its
    // starting value. A rating starts at 5 (the app's default) or 0.
    function statKept(after, before, field, start) {
      return (field in before && field in after && after[field] == before[field])
        || (!(field in before) && (!(field in after) || after[field] == start
            || (field == 'rating' && after[field] == 0)));
    }
    function startingWorkerStats(wp) {
      return wp.get('averageRating', 0) == 0
        && wp.get('totalReviews', 0) == 0
        && wp.get('totalJobsCompleted', 0) == 0;
    }
    // New accounts start with no reputation.
    function startingStats(d) {
      return (d.get('rating', 5) == 5 || d.get('rating', 5) == 0)
        && d.get('totalReviews', 0) == 0
        && startingWorkerStats(d.get('workerProfile', {}));
    }

    // Free plan (Phase S4): when the client confirms a contract, the worker's
    // completed-jobs count goes up by exactly one, in the same write, naming
    // that contract. A contract completes once, so it is credited once.
    function jobCompletionCreditAllowed(userId) {
      let before = resource.data;
      let after = request.resource.data;
      let cid = after.get('lastCompletedContractId', '');
      let c = get(contractPath(cid)).data;
      return isAuthenticated() && userId != request.auth.uid
        && after.diff(before).affectedKeys().hasOnly(['workerProfile', 'lastCompletedContractId'])
        && after.workerProfile.diff(before.get('workerProfile', {})).affectedKeys().hasOnly(['totalJobsCompleted'])
        && after.workerProfile.totalJobsCompleted == before.get('workerProfile', {}).get('totalJobsCompleted', 0) + 1
        && c.workerId == userId && c.clientId == request.auth.uid
        && stageSubmitted(c)
        && contractAfterOf(cid).status == 'completed';
    }

    // ── Users ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      // The full account (phone, email, push token, addresses, earnings,
      // verification fields) is private: the owner and staff only. Everyone
      // else reads publicProfiles/{uid}, kept by a trusted function.
      allow read: if isOwner(userId) || isAdmin();
      // Self-created profiles: client/worker (or '' = role not chosen yet, kept
      // for older app versions), active, and never pre-verified.
      allow create: if isOwner(userId)
                    && request.resource.data.get('role', '') in ['', 'client', 'worker']
                    && request.resource.data.get('isActive', true) == true
                    && request.resource.data.get('isCnicVerified', false) == false
                    && !('cnicNumber' in request.resource.data)
                    && request.resource.data.get('workerProfile', {}).get('isVerified', false) == false
                    && request.resource.data.get('workerProfile', {}).get('verificationStatus', '') in ['', 'pending']
                    && startingStats(request.resource.data)
                    && isValidLocationUpdate(request.resource.data);
      allow update: if (isOwner(userId) && isValidLocationUpdate(request.resource.data)
                        && isProtectedProfileDataUnchanged()) || isAdmin()
                    || jobCompletionCreditAllowed(userId);
      allow delete: if isAdmin();

      // Private verification documents (free plan, Phase S6): the owner
      // adds them; only the owner and staff read them. Kept once added
      // except by the owner (replacing one before submitting) or staff.
      match /verificationDocs/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isActiveUser()
          && docId.matches('^[A-Za-z0-9_-]{1,100}$')
          && request.resource.data.keys().hasOnly(['data', 'contentType', 'createdAt'])
          && privateFileValid(request.resource.data, true);
        allow update: if false;
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Private verification submission (CNIC + document paths).
      // Readable only by the owner and staff; never part of public profiles.
      match /private/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isAdmin() || (
          isOwner(userId)
          && docId == 'verification'
          && request.resource.data.keys().hasOnly(['cnicNumber', 'documents', 'status', 'submittedAt', 'updatedAt'])
          && request.resource.data.get('status', 'pending') == 'pending'
          && request.resource.data.cnicNumber is string
          && request.resource.data.cnicNumber.matches('^[0-9]{5}-[0-9]{7}-[0-9]$')
          && request.resource.data.documents is list
          && request.resource.data.documents.size() >= 1
          && request.resource.data.documents.size() <= 3
          && isOwnVerificationPath(userId, request.resource.data.documents[0])
          && (request.resource.data.documents.size() < 2
              || isOwnVerificationPath(userId, request.resource.data.documents[1]))
          && (request.resource.data.documents.size() < 3
              || isOwnVerificationPath(userId, request.resource.data.documents[2]))
        );
        allow delete: if isAdmin();
      }
    }

    // ── Public profiles ───────────────────────────────────────────────────
    // Allowlisted public view of users/{uid}: no phone, email, CNIC, push
    // token, addresses, earnings or verification data; worker areas ~1 km.
    //
    // Free plan (no Cloud Functions, Phase S2): the owner's app writes its
    // own public profile. The rules decide what it may contain:
    // - only allowlisted fields (nothing private can be published);
    // - everything other people rely on (role, active, rating, reviews,
    //   verified badges, jobs completed) must equal the private account,
    //   which the owner cannot change (see isProtectedProfileDataUnchanged);
    // - "email/phone verified" only when the sign-in token says so;
    // - locations only at ~1 km precision (2 decimal places).
    // Self-description (name, bio, skills, rates…) is the owner's own text.
    function publicUserKeys() {
      return ['uid', 'displayName', 'photoUrl', 'role', 'isActive', 'city',
        'isEmailVerified', 'isPhoneVerified', 'isCnicVerified', 'createdAt',
        'rating', 'totalReviews', 'location', 'geohash', 'locationAccuracy',
        'workerProfile', 'updatedAt'];
    }
    function publicWorkerKeys() {
      return ['headline', 'bio', 'categoryId', 'categoryName', 'skills', 'experience',
        'hourlyRate', 'dailyRate', 'availability', 'isVerified', 'city',
        'serviceRadius', 'totalJobsCompleted', 'averageRating', 'totalReviews',
        'coverImage', 'languages', 'responseTime', 'portfolioImages', 'beforeAfterImages',
        'certifications', 'location', 'geohash', 'locationAccuracy'];
    }
    // ~1.1 km: the point has at most 2 decimal places.
    function isCoarse(p) {
      return isValidGeoPoint(p)
        && math.abs(p.latitude() * 100 - math.round(p.latitude() * 100)) < 0.0001
        && math.abs(p.longitude() * 100 - math.round(p.longitude() * 100)) < 0.0001;
    }
    function sameAs(pub, priv, field) {
      return pub.get(field, null) == priv.get(field, null);
    }
    function publicWorkerValid(pub, priv) {
      let wp = pub.get('workerProfile', null);
      let src = priv.get('workerProfile', {});
      return wp == null || (
        wp is map
        && priv.get('role', '') == 'worker'
        && wp.keys().hasOnly(publicWorkerKeys())
        && sameAs(wp, src, 'isVerified')
        && sameAs(wp, src, 'averageRating')
        && sameAs(wp, src, 'totalReviews')
        && sameAs(wp, src, 'totalJobsCompleted')
        && (!('location' in wp) || isCoarse(wp.location))
        && (!('certifications' in wp) || (wp.certifications is list && wp.certifications.size() <= 20)));
    }
    function publicProfileValid(userId) {
      let pub = request.resource.data;
      let priv = get(/databases/$(database)/documents/users/$(userId)).data;
      return pub.keys().hasOnly(publicUserKeys())
        && pub.get('uid', '') == userId
        && sameAs(pub, priv, 'role')
        && sameAs(pub, priv, 'isActive')
        && sameAs(pub, priv, 'isCnicVerified')
        && sameAs(pub, priv, 'rating')
        && sameAs(pub, priv, 'totalReviews')
        && sameAs(pub, priv, 'createdAt')
        && (pub.get('isEmailVerified', false) != true || request.auth.token.email_verified == true)
        && (pub.get('isPhoneVerified', false) != true || request.auth.token.get('phone_number', null) != null)
        && (!('location' in pub) || pub.location == null || isCoarse(pub.location))
        && publicWorkerValid(pub, priv);
    }
    match /publicProfiles/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId)
        && exists(/databases/$(database)/documents/users/$(userId))
        && publicProfileValid(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // A worker's live position: the worker, staff, and the clients of jobs
    // currently assigned to that worker (viewerIds, set by the function).
    // Unused by the app (live tracking uses contracts/{id}/live/location),
    // and with no Cloud Functions nothing writes it: kept closed.
    match /liveLocations/{workerId} {
      allow read: if isOwner(workerId) || isAdmin()
        || (isAuthenticated() && request.auth.uid in resource.data.viewerIds);
      allow write: if false;
    }

    // ── Jobs ──────────────────────────────────────────────────────────────
    // Each operation has exactly one allow statement, so no broader rule can
    // widen a narrower one (allow statements are OR-combined).

    function isActiveUser() {
      return currentUserData().get('isActive', true) == true;
    }

    // Listed in the job feed: open and not a direct request to one worker.
    // Plain field access on purpose: with .get(field, default) the emulator
    // allowed a status-only query that returned other workers' direct requests.
    function isPublicOpenJob(data) {
      return data.status == 'open' && data.selectedWorkerId == null;
    }

    // Every field a job may hold. Anything else (e.g. moderation flags) can
    // only be written by staff.
    function jobKeysAllowed(data) {
      return data.keys().hasOnly([
        'clientId', 'clientName', 'clientPhotoUrl', 'title', 'description',
        'categoryId', 'categoryName', 'requiredSkills', 'jobType',
        'budgetMin', 'budgetMax', 'budgetType', 'budgetBand',
        'location', 'geohash', 'locationAccuracy', 'locationUpdatedAt',
        'address', 'city', 'status', 'urgency', 'images', 'totalProposals',
        'selectedWorkerId', 'selectedWorkerName', 'startDate', 'endDate',
        'createdAt', 'updatedAt', 'isPaid', 'searchKeywords']);
    }

    function jobContentValid(d) {
      return d.title is string && d.title.size() >= 5 && d.title.size() <= 100
        && d.description is string && d.description.size() >= 10 && d.description.size() <= 2000
        && d.categoryName is string && d.categoryName.size() > 0 && d.categoryName.size() <= 60
        && d.requiredSkills is list && d.requiredSkills.size() <= 15
        && d.budgetType in ['fixed', 'hourly', 'daily']
        && d.budgetMin is number && d.budgetMin >= 0
        && d.budgetMax is number && d.budgetMax >= d.budgetMin && d.budgetMax <= 10000000
        && d.status in ['open', 'assigned', 'in_progress', 'completed', 'cancelled']
        && (!('images' in d) || (d.images is list && d.images.size() <= 6))
        && (!('searchKeywords' in d) || (d.searchKeywords is list && d.searchKeywords.size() <= 300))
        && isValidLocationUpdate(d);
    }

    function jobCreateAllowed() {
      let d = request.resource.data;
      return isClient() && isActiveUser()
        && d.clientId == request.auth.uid
        && d.createdAt == request.time
        && d.get('totalProposals', 0) == 0
        && d.get('isPaid', false) == false
        && jobKeysAllowed(d) && jobContentValid(d)
        && (isPublicOpenJob(d)
          // Direct request / direct hire to one worker (not to yourself).
          || (d.status in ['open', 'assigned']
            && d.selectedWorkerId is string && d.selectedWorkerId != request.auth.uid));
    }

    // The owning client: edit while open, close, reopen, hire, finish.
    function ownerJobUpdateAllowed(jobId) {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      return before.clientId == request.auth.uid && isActiveUser()
        && !changed.hasAny(['clientId', 'createdAt', 'totalProposals', 'isPaid'])
        && jobKeysAllowed(after) && jobContentValid(after)
        && (
          // Edit an open job; assignment stays as it is.
          (before.status == 'open' && after.status == 'open'
            && !changed.hasAny(['selectedWorkerId', 'selectedWorkerName']))
          // Close.
          || (before.status == 'open' && after.status == 'cancelled'
            && changed.hasOnly(['status', 'updatedAt']))
          // Reopen a closed public job.
          || (before.status == 'cancelled' && after.status == 'open'
            && before.get('selectedWorkerId', null) == null
            && changed.hasOnly(['status', 'updatedAt']))
          // Hiring (open → assigned) and every later step (start, complete,
          // cancel) go with the contract: see jobHireAllowed and
          // jobContractStepAllowed (free plan, Phase S4).
        );
    }

    // The owner hires on their public open job: in the same write the
    // contract `{jobId}_{worker}` is created, active, for this client.
    function jobHireAllowed(jobId) {
      let before = resource.data;
      let after = request.resource.data;
      let cid = jobId + '_' + after.get('selectedWorkerId', '');
      return before.clientId == request.auth.uid && isActiveUser()
        && isPublicOpenJob(before) && after.status == 'assigned'
        && after.diff(before).affectedKeys().hasOnly(['status', 'selectedWorkerId', 'selectedWorkerName', 'updatedAt'])
        && after.selectedWorkerId is string
        && !exists(contractPath(cid))
        && contractAfterOf(cid).status == 'active'
        && contractAfterOf(cid).clientId == request.auth.uid;
    }

    // The job follows its contract `{jobId}_{selectedWorker}` (changed in the
    // same write): start → in progress (worker), confirm → completed
    // (client), cancel/decline → cancelled (either), a direct request
    // accepted → assigned (worker).
    function jobContractStepAllowed(jobId) {
      let before = resource.data;
      let after = request.resource.data;
      let w = before.get('selectedWorkerId', null);
      let c = contractAfterOf(jobId + '_' + w);
      let me = request.auth.uid;
      return w is string && isActiveUser() && (before.clientId == me || w == me)
        && after.diff(before).affectedKeys().hasOnly(['status', 'selectedWorkerName', 'updatedAt'])
        && (
          (w == me && before.status == 'assigned' && after.status == 'in_progress'
            && c.get('workStartedAt', null) != null)
          || (before.clientId == me && before.status in ['assigned', 'in_progress'] && after.status == 'completed'
            && c.status == 'completed')
          || (before.status in ['open', 'assigned', 'in_progress'] && after.status == 'cancelled'
            && c.status in ['cancelled', 'rejected'])
          || (w == me && before.status == 'open' && after.status == 'assigned' && c.status == 'active'));
    }

    // Free plan (no Cloud Functions, Phase S3): the proposal count moves by
    // exactly one, in the same write as the worker's own proposal changing
    // the same way: sent or re-sent (+1), withdrawn (-1). Nothing else on the
    // job changes, and it never goes below 0.
    function proposalPath(pid) {
      return /databases/$(database)/documents/proposals/$(pid);
    }
    function proposalCounterUpdateAllowed(jobId) {
      let before = resource.data;
      let after = request.resource.data;
      let pid = jobId + '_' + request.auth.uid;
      let delta = after.get('totalProposals', 0) - before.get('totalProposals', 0);
      return after.diff(before).affectedKeys().hasOnly(['totalProposals'])
        && after.get('totalProposals', 0) >= 0
        && existsAfter(proposalPath(pid))
        && ((delta == 1
              && getAfter(proposalPath(pid)).data.status == 'pending'
              && (!exists(proposalPath(pid)) || get(proposalPath(pid)).data.status == 'withdrawn'))
          || (delta == -1
              && exists(proposalPath(pid))
              && get(proposalPath(pid)).data.status == 'pending'
              && getAfter(proposalPath(pid)).data.status == 'withdrawn'));
    }

    // The worker a job is assigned or directly requested from: status only.
    function assignedWorkerJobUpdateAllowed() {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      return before.get('selectedWorkerId', null) == request.auth.uid && isActiveUser()
        && changed.hasOnly(['status', 'selectedWorkerName', 'updatedAt'])
        // Older direct requests (no contract) can only be declined here.
        // Starting and finishing work go through the contract functions, and
        // a worker can never mark a job completed.
        && before.status == 'open' && after.status == 'cancelled';
    }

    match /jobs/{jobId} {
      // Owner, the selected worker, staff, or anyone active for public open
      // jobs. Feed queries must filter status == 'open' and
      // selectedWorkerId == null to be allowed. Other applicants cannot read
      // a job once it is no longer public (it names the hired worker); they
      // follow its status through proposals/{id}.jobStatus instead.
      allow read: if isAuthenticated() && (
        isAdmin()
        || resource.data.clientId == request.auth.uid
        || resource.data.selectedWorkerId == request.auth.uid
        || (isPublicOpenJob(resource.data) && isActiveUser()));
      allow create: if isAuthenticated() && (isAdmin() || jobCreateAllowed());
      allow update: if isAuthenticated() && (
        isAdmin() || ownerJobUpdateAllowed(jobId) || assignedWorkerJobUpdateAllowed()
        || proposalCounterUpdateAllowed(jobId) || jobHireAllowed(jobId) || jobContractStepAllowed(jobId));
      // Published jobs are kept for history; clients close them instead.
      allow delete: if isAdmin();
    }

    // ── Proposals ─────────────────────────────────────────────────────────
    // One proposal per worker per job: the document id is
    // `{jobId}_{workerId}`, so a second create is refused and a withdrawn
    // proposal is re-sent by updating the same document. `totalProposals`
    // on the job moves by one in the same write (free plan, Phase S3; see
    // proposalCounterUpdateAllowed).
    function jobDoc(jobId) {
      return get(/databases/$(database)/documents/jobs/$(jobId)).data;
    }
    function jobAfter(jobId) {
      return getAfter(/databases/$(database)/documents/jobs/$(jobId)).data;
    }

    function proposalKeysAllowed(d) {
      return d.keys().hasOnly([
        'jobId', 'jobTitle', 'workerId', 'workerName', 'workerPhotoUrl', 'clientId',
        'coverLetter', 'proposedRate', 'rateType', 'estimatedDuration', 'status',
        'createdAt', 'updatedAt', 'viewedAt', 'decidedAt', 'withdrawnAt',
        'resubmittedAt', 'closedReason', 'workerRating', 'jobStatus']);
    }

    function proposalContentValid(d) {
      return d.coverLetter is string && d.coverLetter.size() >= 30 && d.coverLetter.size() <= 2000
        && d.proposedRate is number && d.proposedRate > 0 && d.proposedRate <= 10000000
        && d.rateType in ['fixed', 'hourly', 'daily']
        && d.estimatedDuration is string && d.estimatedDuration.size() >= 2 && d.estimatedDuration.size() <= 60;
    }

    // The job's count, before and after this write.
    function countedOnce(jobId) {
      return jobAfter(jobId).get('totalProposals', 0) == jobDoc(jobId).get('totalProposals', 0) + 1;
    }
    // Withdrawing takes one off. Jobs from before the count was kept may
    // read 0 with proposals still pending: then the count stays at 0.
    function uncountedOnce(jobId) {
      let was = jobDoc(jobId).get('totalProposals', 0);
      let now = jobAfter(jobId).get('totalProposals', 0);
      return (was > 0 && now == was - 1) || (was <= 0 && now == was);
    }

    function proposalCreateAllowed(proposalId) {
      let d = request.resource.data;
      let job = jobDoc(d.jobId);
      return isWorker() && isActiveUser()
        && proposalId == d.jobId + '_' + request.auth.uid
        && d.workerId == request.auth.uid
        && d.status == 'pending'
        && d.createdAt == request.time
        && proposalKeysAllowed(d) && proposalContentValid(d)
        // Decisions, counters and ratings are never set by the worker.
        && !d.keys().hasAny(['viewedAt', 'decidedAt', 'withdrawnAt', 'resubmittedAt', 'closedReason', 'workerRating', 'jobStatus'])
        && isPublicOpenJob(job)
        && job.clientId != request.auth.uid
        && d.clientId == job.clientId
        && d.jobTitle == job.title
        && countedOnce(d.jobId);
    }

    // The client copies the job's real status onto its proposals, so
    // applicants can follow a job they can no longer read (free plan, Phase
    // S3; was the syncJobRelations function). Only that field, only the
    // job's actual status (after this write).
    function proposalJobStatusSyncAllowed() {
      let before = resource.data;
      let after = request.resource.data;
      return before.clientId == request.auth.uid
        && after.diff(before).affectedKeys().hasOnly(['jobStatus'])
        && after.jobStatus == jobAfter(before.jobId).status;
    }

    function proposalUpdateAllowed(proposalId) {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      return isActiveUser()
        // jobStatus only as the job's real status (see the "filled" branch
        // and proposalJobStatusSyncAllowed).
        && !changed.hasAny(['jobId', 'jobTitle', 'workerId', 'clientId', 'createdAt', 'workerRating'])
        && (!changed.hasAny(['jobStatus']) || (before.status == 'pending' && after.status == 'rejected'))
        && proposalKeysAllowed(after)
        && (
          // Worker withdraws a pending proposal (the job's count goes down).
          (before.workerId == request.auth.uid && before.status == 'pending' && after.status == 'withdrawn'
            && changed.hasOnly(['status', 'updatedAt', 'withdrawnAt'])
            && uncountedOnce(before.jobId))
          // Worker re-sends a withdrawn proposal while the job is still open.
          || (before.workerId == request.auth.uid && before.status == 'withdrawn' && after.status == 'pending'
            && changed.hasOnly(['status', 'updatedAt', 'resubmittedAt', 'withdrawnAt', 'viewedAt',
                                'coverLetter', 'proposedRate', 'rateType', 'estimatedDuration',
                                'workerName', 'workerPhotoUrl'])
            && proposalContentValid(after) && isPublicOpenJob(jobDoc(before.jobId))
            && countedOnce(before.jobId))
          // Client opens a pending proposal (shown to the worker as "Viewed").
          || (before.clientId == request.auth.uid && before.status == 'pending' && after.status == 'pending'
            && changed.hasOnly(['viewedAt']) && !('viewedAt' in before) && after.viewedAt == request.time)
          // Client declines (or it closes because someone else was hired;
          // then the job's new status may be copied in the same write).
          || (before.clientId == request.auth.uid && before.status == 'pending' && after.status == 'rejected'
            && changed.hasOnly(['status', 'updatedAt', 'decidedAt', 'closedReason', 'jobStatus'])
            && after.closedReason in ['client', 'filled']
            && (!changed.hasAny(['jobStatus']) || after.jobStatus == jobAfter(before.jobId).status))
          // Client accepts: the contract `{proposalId}` is created in the same
          // write (proposalContractCreateAllowed checks its terms).
          || (before.clientId == request.auth.uid && before.status == 'pending' && after.status == 'accepted'
            && changed.hasOnly(['status', 'updatedAt', 'decidedAt'])
            && after.decidedAt == request.time
            && !exists(contractPath(proposalId))
            && contractAfterOf(proposalId).status == 'active')
        );
    }

    match /proposals/{proposalId} {
      // Only the worker who sent it, the client it was sent to, and staff.
      allow read: if isAuthenticated() && (
        isAdmin()
        || resource.data.workerId == request.auth.uid
        || resource.data.clientId == request.auth.uid);
      allow create: if isAuthenticated() && proposalCreateAllowed(proposalId);
      allow update: if isAuthenticated() && (isAdmin() || proposalUpdateAllowed(proposalId)
        || (isActiveUser() && proposalJobStatusSyncAllowed()));
      // Kept for history; workers withdraw instead.
      allow delete: if isAdmin();
    }

    // ── Contracts ─────────────────────────────────────────────────────────
    // Free plan (no Cloud Functions, Phase S4). Hiring and every lifecycle
    // step are written by the parties' apps in one transaction, and these
    // rules are the state machine the contract functions used to be: who may
    // act, at which stage, exactly which fields change and to what (prices,
    // commission, counts, server times). Every contract id is
    // `{jobId}_{workerId}`, so the job, its proposal and its contract can find
    // each other. Payment fields stay with staff and the payment provider.
    //
    // Stage, from stored fields (as stageOf in functions/src/contracts.ts):
    // pending = booking request; active = not started → in progress
    // (workStartedAt) → submitted (more submissions than revision requests).

    function contractPath(cid) {
      return /databases/$(database)/documents/contracts/$(cid);
    }
    function contractAfterOf(cid) {
      return getAfter(contractPath(cid)).data;
    }
    function submissionsOf(c) {
      return c.get('submissionCount', null) is int ? c.submissionCount
        : (c.get('submittedAt', null) != null ? 1 : 0);
    }
    function revisionsOf(c) {
      return c.get('revisionCount', null) is int ? c.revisionCount : 0;
    }
    // Submitted work waiting for the client.
    function awaitingReviewOf(c) {
      return submissionsOf(c) > revisionsOf(c);
    }
    function stageNotStarted(c) {
      return c.status == 'active' && c.get('workStartedAt', null) == null && !awaitingReviewOf(c);
    }
    function stageInProgress(c) {
      return c.status == 'active' && c.get('workStartedAt', null) != null && !awaitingReviewOf(c);
    }
    function stageSubmitted(c) {
      return c.status == 'active' && awaitingReviewOf(c);
    }
    // Requested, not started or in progress: may still be cancelled, and the
    // client may still share or change the address.
    function stageOpen(c) {
      return c.status == 'pending' || stageNotStarted(c) || stageInProgress(c);
    }
    // A private file kept in Firestore (free plan, Phase S6; Firebase
    // Storage needs the paid plan): bytes under 700 KB, a known type, server
    // time. A document holds at most 1 MiB.
    function privateFileValid(d, allowPdf) {
      return d.data is bytes && d.data.size() > 0 && d.data.size() <= 716800
        && (d.contentType in ['image/jpeg', 'image/png', 'image/webp']
            || (allowPdf && d.contentType == 'application/pdf'))
        && d.createdAt == request.time;
    }

    function textBetween(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function contractKeysAllowed(d) {
      return d.keys().hasOnly([
        'jobId', 'jobTitle', 'jobDescription', 'proposalId',
        'clientId', 'clientName', 'clientPhotoUrl', 'clientPhone',
        'workerId', 'workerName', 'workerPhotoUrl',
        'agreedRate', 'priceMin', 'rateType', 'estimatedDuration', 'totalAmount',
        'commissionRate', 'commissionAmount', 'workerEarnings',
        'paymentStatus', 'paymentProviderState', 'paymentMethod', 'paymentTransactionId',
        'serviceAddress', 'serviceCity', 'serviceArea', 'serviceDate', 'serviceTimeSlot',
        'status', 'acceptedAt', 'startDate', 'endDate', 'workStartedAt', 'submittedAt',
        'completedAt', 'cancelledAt', 'clientReviewed', 'workerReviewed',
        'createdAt', 'updatedAt']);
    }
    // A contract made by hiring starts active and empty: no work, no
    // payment, no address yet, at server time.
    function freshActiveContract(d) {
      return d.status == 'active'
        && d.paymentStatus == 'unpaid'
        && d.get('paymentProviderState', 'not_configured') == 'not_configured'
        && d.acceptedAt == request.time && d.startDate == request.time
        && d.createdAt == request.time && d.updatedAt == request.time
        && d.get('workStartedAt', null) == null && d.get('submittedAt', null) == null
        && d.get('completedAt', null) == null && d.get('cancelledAt', null) == null
        && d.get('endDate', null) == null
        && d.get('clientReviewed', false) == false && d.get('workerReviewed', false) == false
        && !d.keys().hasAny(['serviceAddress', 'paymentMethod', 'paymentTransactionId', 'clientPhone',
                             'serviceDate', 'serviceTimeSlot']);
    }
    // 10% commission, rounded to whole rupees (COMMISSION_RATE).
    function pricedAt(d, amount) {
      return d.agreedRate == amount && d.totalAmount == amount
        && d.commissionRate == 0.1
        && d.commissionAmount == math.round(amount * 0.1)
        && d.workerEarnings == amount - math.round(amount * 0.1);
    }

    // The job owner accepts a pending proposal on their public open job. In
    // the same write: the proposal accepted, the job assigned to that worker.
    // Every term comes from the proposal and the job.
    function proposalContractCreateAllowed(contractId) {
      let d = request.resource.data;
      let p = get(proposalPath(contractId)).data;
      let job = jobDoc(p.jobId);
      return isClient() && isActiveUser()
        && p.clientId == request.auth.uid && p.status == 'pending'
        && contractId == p.jobId + '_' + p.workerId
        && job.clientId == request.auth.uid && isPublicOpenJob(job)
        && getAfter(proposalPath(contractId)).data.status == 'accepted'
        && jobAfter(p.jobId).status == 'assigned'
        && jobAfter(p.jobId).selectedWorkerId == p.workerId
        && contractKeysAllowed(d) && freshActiveContract(d)
        && d.jobId == p.jobId && d.proposalId == contractId
        && d.clientId == request.auth.uid && d.workerId == p.workerId
        && d.workerName == p.get('workerName', '')
        && d.get('workerPhotoUrl', null) == p.get('workerPhotoUrl', null)
        && d.jobTitle == job.title && d.get('jobDescription', '') == job.get('description', '')
        && d.get('serviceCity', null) == job.get('city', null)
        && d.get('serviceArea', null) == job.get('address', null)
        && d.rateType == p.get('rateType', 'fixed')
        && d.get('estimatedDuration', '') == p.get('estimatedDuration', '')
        && !('priceMin' in d)
        && pricedAt(d, p.proposedRate);
    }

    // The requested worker accepts a direct request (an open job sent only to
    // them). Price = the client's budget; a range stays a range (priceMin).
    function directRequestContractCreateAllowed(contractId) {
      let d = request.resource.data;
      let job = jobDoc(d.jobId);
      return isWorker() && isActiveUser()
        && contractId == d.jobId + '_' + request.auth.uid
        && job.get('selectedWorkerId', null) == request.auth.uid && job.status == 'open'
        && jobAfter(d.jobId).status == 'assigned'
        && contractKeysAllowed(d) && freshActiveContract(d)
        && d.proposalId == 'direct_request'
        && d.workerId == request.auth.uid && d.clientId == job.clientId
        && d.get('clientName', '') == job.get('clientName', '')
        && d.get('clientPhotoUrl', null) == job.get('clientPhotoUrl', null)
        && d.jobTitle == job.title && d.get('jobDescription', '') == job.get('description', '')
        && d.get('serviceCity', null) == job.get('city', null)
        && d.get('serviceArea', null) == job.get('address', null)
        && d.rateType == job.budgetType
        && d.get('priceMin', null) == (job.budgetMin < job.budgetMax ? job.budgetMin : null)
        && pricedAt(d, job.budgetMax);
    }

    // A client's booking request to one worker: a pending contract for a
    // direct hire of their own job, created with no lifecycle data.
    function contractCreateAllowed(contractId) {
      let d = request.resource.data;
      return isClient() && isActiveUser()
        && contractId == d.jobId + '_' + d.workerId
        && d.clientId == request.auth.uid
        && d.workerId is string && d.workerId != request.auth.uid
        && d.paymentStatus == 'unpaid'
        && d.status == 'pending'
        && d.proposalId == 'direct_hire'
        && contractKeysAllowed(d)
        && !d.keys().hasAny(['acceptedAt', 'respondedAt', 'workStartedAt', 'submittedAt', 'submission',
                             'completedAt', 'cancelledAt', 'cancelledBy', 'cancelledByRole', 'cancelReason'])
        && jobAfter(d.jobId).clientId == request.auth.uid
        && jobAfter(d.jobId).selectedWorkerId == d.workerId;
    }

    // After completion each party may record that they reviewed (set when
    // writing their review).
    function contractReviewFlagAllowed() {
      let before = resource.data;
      let changed = request.resource.data.diff(before).affectedKeys();
      return before.status == 'completed'
        && ((before.clientId == request.auth.uid && changed.hasOnly(['clientReviewed'])
              && before.get('clientReviewed', false) == false && request.resource.data.clientReviewed == true)
          || (before.workerId == request.auth.uid && changed.hasOnly(['workerReviewed'])
              && before.get('workerReviewed', false) == false && request.resource.data.workerReviewed == true));
    }

    // Evidence must be this contract's own photos (free plan, Phase S6).
    function evidenceOk(contractId, path) {
      return path is string
        && path.matches('^contracts/' + contractId + '/evidence/[A-Za-z0-9_-]{1,80}$')
        && exists(/databases/$(database)/documents/contracts/$(contractId)/evidence/$(path.split('/')[3]));
    }
    function evidenceListValid(contractId, list) {
      return list.size() == 0
        || (evidenceOk(contractId, list[0])
          && (list.size() < 2 || evidenceOk(contractId, list[1]))
          && (list.size() < 3 || evidenceOk(contractId, list[2])));
    }

    // The contract's job moves with it in the same write (if the job exists).
    function jobFollows(jobId, status) {
      return !exists(/databases/$(database)/documents/jobs/$(jobId)) || jobAfter(jobId).status == status;
    }

    // Every lifecycle step (was contractActionCall). Exactly one branch per
    // step; each lists the only fields it may change.
    function contractStepAllowed(contractId) {
      let c = resource.data;
      let n = request.resource.data;
      let ch = n.diff(c).affectedKeys();
      let me = request.auth.uid;
      let asWorker = c.workerId == me;
      let asClient = c.clientId == me;
      return isActiveUser() && (asWorker || asClient)
        && n.get('updatedAt', null) == request.time
        && (
          // respond: the worker accepts a booking request…
          (asWorker && c.status == 'pending' && n.status == 'active'
            && ch.hasOnly(['status', 'respondedAt', 'acceptedAt', 'workStartedAt', 'submittedAt', 'updatedAt'])
            && n.respondedAt == request.time && n.acceptedAt == request.time
            && n.get('workStartedAt', null) == null && n.get('submittedAt', null) == null)
          // …or declines it.
          || (asWorker && c.status == 'pending' && n.status == 'rejected'
            && ch.hasOnly(['status', 'respondedAt', 'updatedAt']) && n.respondedAt == request.time
            && jobFollows(c.jobId, 'cancelled'))
          // start: the hired worker, once, on the job assigned to them.
          || (asWorker && stageNotStarted(c)
            && ch.hasOnly(['workStartedAt', 'updatedAt']) && n.workStartedAt == request.time
            && jobDoc(c.jobId).get('selectedWorkerId', null) == me
            && jobDoc(c.jobId).status == 'assigned'
            && jobAfter(c.jobId).status == 'in_progress')
          // submit: the hired worker, after starting; the submission is
          // also kept in submissions/{number}.
          || (asWorker && stageInProgress(c)
            && ch.hasOnly(['submittedAt', 'submission', 'submissionCount', 'updatedAt'])
            && n.submittedAt == request.time
            && n.submissionCount == submissionsOf(c) + 1
            && n.submission.keys().hasOnly(['note', 'attachments', 'submittedAt'])
            && textBetween(n.submission.note, 10, 1000)
            && n.submission.attachments is list && n.submission.attachments.size() <= 3
            && n.submission.submittedAt == request.time
            && existsAfter(/databases/$(database)/documents/contracts/$(contractId)/submissions/$(string(n.submissionCount))))
          // confirm: the client, only after the work was submitted. The
          // worker's completed-jobs count goes up in the same write.
          || (asClient && stageSubmitted(c) && n.status == 'completed'
            && ch.hasOnly(['status', 'completedAt', 'endDate', 'updatedAt'])
            && n.completedAt == request.time && n.endDate == request.time
            && jobFollows(c.jobId, 'completed')
            && getAfter(/databases/$(database)/documents/users/$(c.workerId)).data.get('lastCompletedContractId', '') == contractId)
          // cancel: either party, before the work is submitted.
          || (stageOpen(c) && n.status == 'cancelled'
            && ch.hasOnly(['status', 'cancelledAt', 'cancelledBy', 'cancelledByRole', 'cancelReason', 'cancelNote', 'updatedAt'])
            && n.cancelledAt == request.time && n.cancelledBy == me
            && jobFollows(c.jobId, 'cancelled')
            && n.cancelledByRole == (asClient ? 'client' : 'worker')
            && n.cancelReason in ['schedule_conflict', 'no_longer_needed', 'agreed_with_other_party', 'safety_concern', 'other']
            && n.get('cancelNote', '') is string && n.get('cancelNote', '').size() <= 300)
          // shareAddress: the client, while open; the map pin is optional
          // (kept, set, or removed together with its time).
          || (asClient && stageOpen(c)
            && ch.hasOnly(['serviceAddress', 'addressSharedAt', 'serviceLocation', 'serviceLocationSetAt', 'updatedAt'])
            && textBetween(n.serviceAddress, 5, 200) && n.addressSharedAt == request.time
            && (!ch.hasAny(['serviceLocation', 'serviceLocationSetAt'])
              || (isValidGeoPoint(n.get('serviceLocation', null))
                  && !(n.serviceLocation.latitude() == 0 && n.serviceLocation.longitude() == 0)
                  && n.serviceLocationSetAt == request.time)
              || (!('serviceLocation' in n) && !('serviceLocationSetAt' in n))))
          // requestRevision: the client sends submitted work back, at most
          // three times; recorded on that submission.
          || (asClient && stageSubmitted(c) && revisionsOf(c) < 3
            && ch.hasOnly(['revisionCount', 'revisionRequestedAt', 'revisionNote', 'submissionCount', 'updatedAt'])
            && n.revisionCount == revisionsOf(c) + 1
            && n.revisionRequestedAt == request.time
            && textBetween(n.revisionNote, 10, 1000)
            && n.submissionCount == submissionsOf(c))
          // progressUpdate: the hired worker, before submitting; the update
          // itself is updates/{lastUpdateId}, written in the same transaction.
          || (asWorker && (stageNotStarted(c) || stageInProgress(c))
            && ch.hasOnly(['lastUpdateAt', 'updateCount', 'lastUpdateId', 'updatedAt'])
            && n.lastUpdateAt == request.time
            && n.updateCount == c.get('updateCount', 0) + 1
            && n.lastUpdateId is string && n.lastUpdateId != c.get('lastUpdateId', '')
            && !exists(/databases/$(database)/documents/contracts/$(contractId)/updates/$(n.lastUpdateId))
            && existsAfter(/databases/$(database)/documents/contracts/$(contractId)/updates/$(n.lastUpdateId)))
        );
    }

    match /contracts/{contractId} {
      allow read: if isAuthenticated() &&
                     (resource.data.clientId == request.auth.uid ||
                      resource.data.workerId == request.auth.uid ||
                      isAdmin());
      allow create: if isAuthenticated() && (isAdmin() || contractCreateAllowed(contractId)
        || proposalContractCreateAllowed(contractId) || directRequestContractCreateAllowed(contractId));
      allow update: if isAuthenticated() && (isAdmin() || contractReviewFlagAllowed()
        || contractStepAllowed(contractId));
      allow delete: if isAdmin();

      function contractData() {
        return get(/databases/$(database)/documents/contracts/$(contractId)).data;
      }
      function isContractParty() {
        let c = contractData();
        return request.auth.uid == c.clientId || request.auth.uid == c.workerId;
      }
      // Submitted work waiting for the client (see stageOf in contracts.ts).
      function awaitingReview(c) {
        return awaitingReviewOf(c);
      }
      // Live location for this contract only: the hired worker, while the
      // contract is active and the work is not waiting for review, at server
      // time. It is deleted when work is submitted, completed or cancelled
      // (in the same write as that step); the worker deletes it to stop
      // sharing.
      function liveLocationValid(d) {
        let c = contractData();
        return c.workerId == request.auth.uid && c.status == 'active' && !awaitingReview(c) && isActiveUser()
          && d.keys().hasOnly(['workerId', 'position', 'accuracy', 'heading', 'speed', 'updatedAt', 'startedAt'])
          && d.workerId == request.auth.uid
          && isValidGeoPoint(d.position)
          && (!('accuracy' in d) || (d.accuracy is number && d.accuracy >= 0 && d.accuracy <= 100000))
          // Direction of travel (degrees from north) and speed (m/s), optional
          // (Navigation phase 8). 100 m/s is far above any road speed.
          && (!('heading' in d) || (d.heading is number && d.heading >= 0 && d.heading <= 360))
          && (!('speed' in d) || (d.speed is number && d.speed >= 0 && d.speed <= 100))
          && d.updatedAt == request.time;
      }

      match /live/{docId} {
        allow read: if isAuthenticated() && (isAdmin() || isContractParty());
        allow create: if isAuthenticated() && docId == 'location'
          && liveLocationValid(request.resource.data) && request.resource.data.startedAt == request.time;
        // Same session (start time kept), or sharing started again (a new
        // start time, at server time only).
        allow update: if isAuthenticated() && docId == 'location'
          && liveLocationValid(request.resource.data)
          && (request.resource.data.startedAt == resource.data.startedAt || request.resource.data.startedAt == request.time);
        // The worker, staff, or the client in the step that ends sharing
        // (cancel or confirm: the contract is no longer open for work after
        // this write).
        allow delete: if isAuthenticated() && (isAdmin() || contractData().workerId == request.auth.uid
          || (contractData().clientId == request.auth.uid
              && (contractAfterOf(contractId).status != 'active' || awaitingReviewOf(contractAfterOf(contractId)))));
      }

      // Work evidence photos (free plan, Phase S6; were in Storage): only the
      // hired worker adds them, while the work is in progress; the two
      // parties and staff read them; kept as part of the record.
      match /evidence/{photoId} {
        allow read: if isAuthenticated() && (isAdmin() || isContractParty());
        allow create: if isAuthenticated() && isActiveUser()
          && contractData().workerId == request.auth.uid
          && stageInProgress(contractData())
          && photoId.matches('^[A-Za-z0-9_-]{1,80}$')
          && request.resource.data.keys().hasOnly(['data', 'contentType', 'uploadedBy', 'createdAt'])
          && request.resource.data.uploadedBy == request.auth.uid
          && privateFileValid(request.resource.data, false);
        allow update, delete: if isAdmin();
      }

      // Progress updates: written by the hired worker together with the
      // contract step (lastUpdateId); readable by the two parties and staff.
      match /updates/{updateId} {
        allow read: if isAuthenticated() && (isAdmin() || isContractParty());
        allow create: if isAuthenticated()
          && contractData().workerId == request.auth.uid
          && updateId.matches('^[A-Za-z0-9_-]{8,64}$')
          && contractAfterOf(contractId).get('lastUpdateId', '') == updateId
          && request.resource.data.keys().hasOnly(['note', 'authorId', 'authorRole', 'createdAt'])
          && textBetween(request.resource.data.note, 2, 1000)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorRole == 'worker'
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      // Submission history. The worker adds each submission with the submit
      // step; the client records a revision request on it with that step.
      // Contracts from before the counter existed get their first record
      // created by the client's revision request.
      function submissionNumberOk(submissionId, c) {
        return submissionId == string(c.submissionCount);
      }
      match /submissions/{submissionId} {
        allow read: if isAuthenticated() && (isAdmin() || isContractParty());
        allow create: if isAuthenticated() && (
          // Worker: this submission, same note and photos as the contract's.
          (contractData().workerId == request.auth.uid
            && stageInProgress(contractData())
            && submissionNumberOk(submissionId, contractAfterOf(contractId))
            && request.resource.data.keys().hasOnly(['number', 'note', 'attachments', 'submittedAt', 'submittedBy'])
            && request.resource.data.number == contractAfterOf(contractId).submissionCount
            && request.resource.data.note == contractAfterOf(contractId).submission.note
            && request.resource.data.attachments == contractAfterOf(contractId).submission.attachments
            // Only this contract's own evidence photos (free plan, Phase S6).
            && evidenceListValid(contractId, request.resource.data.attachments)
            && request.resource.data.submittedAt == request.time
            && request.resource.data.submittedBy == request.auth.uid)
          // Client, older contract: the first record, with the revision.
          || (clientRevisionRecordAllowed(submissionId)
            && request.resource.data.keys().hasOnly(['number', 'revisionNote', 'revisionRequestedAt',
                                                     'note', 'attachments', 'submittedAt'])
            && request.resource.data.get('note', '') == contractData().get('submission', {}).get('note', '')
            && request.resource.data.get('attachments', []) == contractData().get('submission', {}).get('attachments', [])
            && request.resource.data.get('submittedAt', null) == contractData().get('submittedAt', null)));
        allow update: if isAuthenticated() && clientRevisionRecordAllowed(submissionId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['number', 'revisionNote', 'revisionRequestedAt']);
        allow delete: if false;
      }
      // The client's revision request on the submission it answers.
      function clientRevisionRecordAllowed(submissionId) {
        let c = contractData();
        let a = contractAfterOf(contractId);
        return c.clientId == request.auth.uid && stageSubmitted(c)
          && a.get('revisionCount', 0) == revisionsOf(c) + 1
          && submissionNumberOk(submissionId, a)
          && request.resource.data.number == a.submissionCount
          && request.resource.data.revisionNote == a.revisionNote
          && request.resource.data.revisionRequestedAt == request.time;
      }
    }

    // ── Reviews ───────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                       (isAdmin() || (
                         request.resource.data.reviewerId == request.auth.uid &&
                         request.resource.data.contractId is string &&
                         reviewId == request.resource.data.contractId + '_' + request.auth.uid &&
                         exists(/databases/$(database)/documents/contracts/$(request.resource.data.contractId)) &&
                         get(/databases/$(database)/documents/contracts/$(request.resource.data.contractId)).data.status == 'completed' &&
                         request.resource.data.isVerifiedCustomer == true &&
                         request.resource.data.rating is number &&
                         request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                         ((get(/databases/$(database)/documents/contracts/$(request.resource.data.contractId)).data.clientId == request.auth.uid &&
                           get(/databases/$(database)/documents/contracts/$(request.resource.data.contractId)).data.workerId == request.resource.data.revieweeId &&
                           get(/databases/$(database)/documents/contracts/$(request.resource.data.contractId)).data.clientReviewed == false) ||
                          (get(/databases/$(database)/documents/contracts/$(request.resource.data.contractId)).data.workerId == request.auth.uid &&
                           get(/databases/$(database)/documents/contracts/$(request.resource.data.contractId)).data.clientId == request.resource.data.revieweeId &&
                           get(/databases/$(database)/documents/contracts/$(request.resource.data.contractId)).data.workerReviewed == false)) &&
                         // Free plan (Phase S5): the reviewee's rating ledger
                         // takes this review in the same write.
                         getAfter(/databases/$(database)/documents/ratings/$(request.resource.data.revieweeId)).data.lastReviewId == reviewId
                       ));
      allow update: if isAdmin() || (isAuthenticated() &&
                       resource.data.revieweeId == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['workerReply', 'workerReplyAt']));
      allow delete: if isAdmin();
    }

    // ── Rating ledger (free plan, Phase S5; was aggregateReviewRating) ────
    // One per person: how many reviews, their sum and the average (one
    // decimal). It moves only together with a new review of that person, by
    // exactly that review. Owners copy it onto their account and public
    // profile (the users rules accept only these values).
    function ratingLedgerAllowed(userId) {
      let after = request.resource.data;
      let rid = after.get('lastReviewId', '');
      let review = getAfter(/databases/$(database)/documents/reviews/$(rid)).data;
      let count0 = resource == null ? 0 : resource.data.get('count', 0);
      let sum0 = resource == null ? 0 : resource.data.get('sum', 0);
      return after.keys().hasOnly(['count', 'sum', 'average', 'lastReviewId', 'updatedAt'])
        && rid is string && rid.size() > 0
        && !exists(/databases/$(database)/documents/reviews/$(rid))
        && review.revieweeId == userId && review.reviewerId == request.auth.uid
        && after.count == count0 + 1
        && after.sum == sum0 + review.rating
        && after.average == math.round((after.sum * 1.0) / after.count * 10) / 10.0
        && after.updatedAt == request.time;
    }
    match /ratings/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && userId != request.auth.uid && ratingLedgerAllowed(userId);
      allow delete: if isAdmin();
    }

    // ── Chats / Messages (Phase 4B) ───────────────────────────────────────
    // Free plan (Phase S5): a member's app opens a conversation, and the
    // rules check the same relationship openChatCall did. Each message is
    // written together with the chat's preview, time and the recipient's
    // unread count (+1). A member may also mark it read for themselves.
    function nameOk(name, u) {
      return name == u.get('displayName', '') || name == 'SkillBridge user';
    }
    function photoOk(photo, u) {
      return photo == null || photo == u.get('photoUrl', null);
    }
    function chatCreateAllowed(chatId) {
      let d = request.resource.data;
      let me = request.auth.uid;
      let ids = d.participantIds;
      let other = ids[0] == me ? ids[1] : ids[0];
      let otherUser = get(/databases/$(database)/documents/users/$(other)).data;
      let meUser = currentUserData();
      return isActiveUser()
        && ids is list && ids.size() == 2 && me in ids && other != me
        && otherUser.get('isActive', true) == true
        && d.keys().hasOnly(['participantIds', 'participantNames', 'participantPhotos', 'lastMessage',
                             'lastMessageSenderId', 'lastMessageType', 'lastMessageAt', 'unreadCount',
                             'lastReadAt', 'createdAt', 'createdBy', 'relatedJobId', 'relatedJobTitle'])
        && d.lastMessage == '' && d.lastMessageSenderId == '' && d.lastMessageType == 'none'
        && d.lastMessageAt == request.time && d.createdAt == request.time && d.createdBy == me
        && d.unreadCount.keys().hasOnly([me, other])
        && d.unreadCount.get(me, -1) == 0 && d.unreadCount.get(other, -1) == 0
        && d.lastReadAt.keys().size() == 0
        && d.participantNames.keys().hasOnly([me, other])
        && nameOk(d.participantNames.get(me, ''), meUser) && nameOk(d.participantNames.get(other, ''), otherUser)
        && d.participantPhotos.keys().hasOnly([me, other])
        && photoOk(d.participantPhotos.get(me, null), meUser) && photoOk(d.participantPhotos.get(other, null), otherUser)
        && (jobChatAllowed(chatId, d, ids, me) || directChatAllowed(chatId, d, me, other, otherUser));
    }
    // About a job: its client and a worker who may write about it (writing
    // about a public open job, applied, or selected/hired).
    function jobChatAllowed(chatId, d, ids, me) {
      let job = jobDoc(d.relatedJobId);
      let worker = ids[0] == job.clientId ? ids[1] : ids[0];
      return 'relatedJobId' in d && job.clientId in ids
        && chatId == d.relatedJobId + '_' + worker
        && d.get('relatedJobTitle', '') == job.title
        && ((worker == me && isWorker() && isPublicOpenJob(job))
          || exists(/databases/$(database)/documents/proposals/$(d.relatedJobId + '_' + worker))
          || job.get('selectedWorkerId', null) == worker);
    }
    // Outside a job: only an active client starts one, with an active worker.
    function directChatAllowed(chatId, d, me, other, otherUser) {
      return !('relatedJobId' in d) && !('relatedJobTitle' in d)
        && chatId == 'direct_' + me + '_' + other
        && isClient() && otherUser.get('role', '') == 'worker';
    }
    function chatSummaryAllowed(chatId) {
      let me = request.auth.uid;
      let before = resource.data;
      let after = request.resource.data;
      let ids = before.participantIds;
      let other = ids[0] == me ? ids[1] : ids[0];
      let mid = after.get('lastMessageId', '');
      return me in ids
        && after.diff(before).affectedKeys().hasOnly(['lastMessage', 'lastMessageSenderId', 'lastMessageType',
                                                       'lastMessageAt', 'lastMessageId', 'unreadCount'])
        && after.lastMessageSenderId == me && after.lastMessageAt == request.time
        && after.lastMessage is string && after.lastMessage.size() <= 130
        && mid is string && mid != before.get('lastMessageId', '')
        && !exists(/databases/$(database)/documents/chats/$(chatId)/messages/$(mid))
        && getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(mid)).data.senderId == me
        && after.lastMessageType == getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(mid)).data.type
        && after.unreadCount.diff(before.get('unreadCount', {})).affectedKeys().hasOnly([other])
        && after.unreadCount.get(other, 0) == before.get('unreadCount', {}).get(other, 0) + 1;
    }
    function chatMarkReadAllowed() {
      let me = request.auth.uid;
      let after = request.resource.data;
      let changed = after.diff(resource.data).affectedKeys();
      return me in resource.data.participantIds
        && changed.hasOnly(['lastReadAt', 'unreadCount'])
        && after.get('lastReadAt', {}).diff(resource.data.get('lastReadAt', {})).affectedKeys().hasOnly([me])
        && after.get('unreadCount', {}).diff(resource.data.get('unreadCount', {})).affectedKeys().hasOnly([me])
        && after.lastReadAt[me] == request.time
        && after.get('unreadCount', {}).get(me, 0) == 0;
    }

    match /chats/{chatId} {
      // Members and staff only, so no-one can probe which chats exist.
      allow read: if isAuthenticated() && (isAdmin() || request.auth.uid in resource.data.participantIds);
      allow create: if isAuthenticated() && (isAdmin() || chatCreateAllowed(chatId));
      allow update: if isAuthenticated() && (isAdmin() || chatMarkReadAllowed() || chatSummaryAllowed(chatId));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        function chatData() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        function isChatMember() {
          return request.auth.uid in chatData().participantIds;
        }
        // Messages to a suspended or deleted account are refused.
        function recipientActive() {
          let ids = chatData().participantIds;
          let other = ids[0] == request.auth.uid ? ids[1] : ids[0];
          return exists(/databases/$(database)/documents/users/$(other))
            && get(/databases/$(database)/documents/users/$(other)).data.get('isActive', true) == true;
        }
        // Free plan (Phase S6): photos are this chat's private files for this
        // message, added by the sender (chats/{chat}/media/{message}_p{n}).
        function attachmentOk(path) {
          return path is string
            && path.matches('^chats/' + chatId + '/media/' + messageId + '_p[0-9]$')
            && exists(/databases/$(database)/documents/chats/$(chatId)/media/$(path.split('/')[3]))
            && get(/databases/$(database)/documents/chats/$(chatId)/media/$(path.split('/')[3])).data.senderId == request.auth.uid;
        }
        function attachmentsValid(d) {
          return d.attachments is list && d.attachments.size() >= 1 && d.attachments.size() <= 3
            && attachmentOk(d.attachments[0])
            && (d.attachments.size() < 2 || attachmentOk(d.attachments[1]))
            && (d.attachments.size() < 3 || attachmentOk(d.attachments[2]));
        }
        function messageValid(d) {
          return d.keys().hasOnly(['chatId', 'senderId', 'senderName', 'senderPhotoUrl', 'content', 'type',
                                   'isRead', 'createdAt', 'attachments'])
            && d.senderId == request.auth.uid
            && d.chatId == chatId
            && d.createdAt == request.time
            && d.isRead == false
            && d.content is string && d.content.size() <= 5000
            && ((d.type == 'text' && d.content.trim().size() > 0 && !('attachments' in d))
              || (d.type == 'image' && attachmentsValid(d)));
        }

        allow read: if isAuthenticated() && (isAdmin() || isChatMember());
        // Members post as themselves, at server time, with a client-chosen id
        // so a retry can never create a second copy (create-only).
        allow create: if isAuthenticated() && isChatMember() && isActiveUser()
          && messageId.matches('[A-Za-z0-9_-]{8,64}')
          && recipientActive()
          && messageValid(request.resource.data)
          // The chat summary moves with it (free plan, Phase S5).
          && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.get('lastMessageId', '') == messageId;
        // The recipient may mark a message read; nothing else changes.
        allow update: if isAuthenticated() && isChatMember()
          && resource.data.senderId != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
          && request.resource.data.isRead == true;
        allow delete: if isAdmin();
      }

      // Chat photos (free plan, Phase S6; were in Storage): members only. The
      // sender adds them before the message that shows them.
      match /media/{mediaId} {
        function memberOfThisChat() {
          return request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        }
        allow read: if isAuthenticated() && (isAdmin() || memberOfThisChat());
        allow create: if isAuthenticated() && isActiveUser() && memberOfThisChat()
          && mediaId.matches('^[A-Za-z0-9_-]{8,64}_p[0-9]$')
          && request.resource.data.keys().hasOnly(['data', 'contentType', 'senderId', 'messageId', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.messageId is string
          && request.resource.data.messageId.matches('^[A-Za-z0-9_-]{8,64}$')
          && mediaId.matches('^' + request.resource.data.messageId + '_p[0-9]$')
          && privateFileValid(request.resource.data, false);
        allow update, delete: if isAdmin();
      }
    }

    // ── Categories ────────────────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Notifications ─────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read, update, delete: if isAuthenticated() &&
                                     (resource.data.userId == request.auth.uid || isAdmin());
      // Free plan (Phase S5): in-app only (no push without a server). Sent by
      // the other person's app, so the rules require a real link: a contract
      // both are party to, a chat both are in, or a job between its client and
      // a worker who applied or was chosen. Short, unread, at server time.
      allow create: if isAuthenticated() && notificationAllowed();
    }

    function notificationAllowed() {
      let n = request.resource.data;
      let me = request.auth.uid;
      let p = n.get('payload', {});
      return isActiveUser()
        && n.keys().hasOnly(['userId', 'title', 'body', 'type', 'payload', 'referenceId', 'isRead', 'createdAt'])
        && n.userId is string && n.userId != me
        && textBetween(n.title, 1, 100) && n.body is string && n.body.size() <= 400
        && n.get('type', '') is string && n.get('type', '').size() <= 40
        && n.get('referenceId', '') is string
        && n.isRead == false && n.createdAt == request.time
        && p is map && p.keys().hasOnly(['contractId', 'jobId', 'proposalId', 'chatId', 'messageId'])
        && ((p.get('contractId', '') != '' && contractPartiesAre(p.contractId, me, n.userId))
          || (p.get('chatId', '') != '' && chatMembersAre(p.chatId, me, n.userId))
          || (p.get('jobId', '') != '' && jobLinked(p.jobId, me, n.userId)));
    }
    function contractPartiesAre(cid, a, b) {
      let c = contractAfterOf(cid);
      return (c.clientId == a && c.workerId == b) || (c.workerId == a && c.clientId == b);
    }
    function chatMembersAre(chatId, a, b) {
      return getAfter(/databases/$(database)/documents/chats/$(chatId)).data.participantIds.hasAll([a, b]);
    }
    function jobLinked(jobId, me, other) {
      let j = jobAfter(jobId);
      return (j.clientId == other && existsAfter(/databases/$(database)/documents/proposals/$(jobId + '_' + me)))
        || (j.clientId == me && j.get('selectedWorkerId', null) == other)
        || (j.get('selectedWorkerId', null) == me && j.clientId == other);
    }

    // ── FCM Tokens ────────────────────────────────────────────────────────
    match /fcmTokens/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ── User reports ─────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if isAuthenticated()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetUserId is string
        && request.resource.data.targetUserId != request.auth.uid
        && request.resource.data.status == 'open';
      allow read: if isAuthenticated()
        && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
  }
}
