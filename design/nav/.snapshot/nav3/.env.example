# Copy to `.env` (git-ignored) and fill in. Never commit `.env`.
#
# Used at BUILD time only — `.env` is not bundled into the app:
#   flutter run   --dart-define-from-file=.env
#   flutter build apk --dart-define-from-file=.env
#   (Android Gradle also reads GOOGLE_MAPS_API_KEY from here for the map SDK.)
#
# Values passed this way are compiled into the app, so they must be keys that
# are safe in a client app *when restricted*. Never put server secrets here
# (service-account keys, Firebase Admin credentials, payment secrets).

# Google Maps Platform key. Restrict it in Google Cloud console:
# application restriction (Android package + SHA-1 / iOS bundle ID) and API
# restriction (Maps SDK, Geocoding, Places API (New), Routes only).
GOOGLE_MAPS_API_KEY=

# Firebase App Check — public reCAPTCHA v3 *site* key for the web app
# (Firebase console → App Check → Apps → Web). Needed for web release builds.
RECAPTCHA_V3_SITE_KEY=

# ── Maps, routing and address search (OpenStreetMap stack; no keys) ──────
# Blank means the default. The defaults are the PUBLIC OpenStreetMap
# services: fine for development and light use, but with no availability
# guarantee and strict usage policies. For production, point these at a
# self-hosted or commercial provider.
#
# Map tiles (XYZ raster). Needs {z} {x} {y}; {s} needs MAP_TILE_SUBDOMAINS.
# Default: https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_URL=
MAP_TILE_SUBDOMAINS=
# Required by the tile provider's licence; shown on every map.
# Default: © OpenStreetMap contributors (https://www.openstreetmap.org/copyright)
MAP_TILE_ATTRIBUTION=
MAP_TILE_ATTRIBUTION_URL=
MAP_TILE_MAX_ZOOM=

# Road routing: an OSRM-compatible /route/v1 server.
# Default: https://router.project-osrm.org (public demo, car profile only).
ROUTING_BASE_URL=
# driving | cycling | walking (depends on the server). Default: driving
ROUTING_PROFILE=

# Address search: "nominatim" (any Nominatim-compatible server; search on
# submit only, at most 1 request/second) or "none" (pick on the map only).
# Blank: the public Nominatim server in debug builds, "none" in release
# builds. Public Nominatim forbids autocomplete and heavy use, and requires
# that apps can switch away without an update; read its policy before
# shipping with it: https://operations.osmfoundation.org/policies/nominatim/
GEOCODING_PROVIDER=
# Default: https://nominatim.openstreetmap.org
GEOCODING_BASE_URL=
# Default: pk
GEOCODING_COUNTRY_CODES=

# Optional: App Check debug token registered in Firebase console (debug builds).
# Treat as a secret while it is registered.
APP_CHECK_DEBUG_TOKEN=
