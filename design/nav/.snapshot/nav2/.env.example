# Copy to `.env` (git-ignored) and fill in. Never commit `.env`.
#
# Used at BUILD time only — `.env` is not bundled into the app:
#   flutter run   --dart-define-from-file=.env
#   flutter build apk --dart-define-from-file=.env
#   (Android Gradle also reads GOOGLE_MAPS_API_KEY from here for the map SDK.)
#
# Values passed this way are compiled into the app, so they must be keys that
# are safe in a client app *when restricted*. Never put server secrets here
# (service-account keys, Firebase Admin credentials, payment secrets).

# Google Maps Platform key. Restrict it in Google Cloud console:
# application restriction (Android package + SHA-1 / iOS bundle ID) and API
# restriction (Maps SDK, Geocoding, Places API (New), Routes only).
GOOGLE_MAPS_API_KEY=

# Firebase App Check — public reCAPTCHA v3 *site* key for the web app
# (Firebase console → App Check → Apps → Web). Needed for web release builds.
RECAPTCHA_V3_SITE_KEY=

# Optional: App Check debug token registered in Firebase console (debug builds).
# Treat as a secret while it is registered.
APP_CHECK_DEBUG_TOKEN=
