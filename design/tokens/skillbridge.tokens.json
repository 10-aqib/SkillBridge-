{
  "$description": "SkillBridge design tokens — single source of truth. Flutter (lib/config/theme/sb/sb_tokens.dart) and the admin web (super_admin_web/src/styles/sb-tokens.css) mirror these values by hand. Run `node design/tools/check-contrast.mjs` after any change.",
  "brand": {
    "philosophy": "Local expertise, made easier to trust.",
    "inkBlue": "#174A8B",
    "craftAmber": "#E4A33A",
    "trustTeal": "#167A63",
    "warmCanvas": "#F7F8F6"
  },
  "color": {
    "light": {
      "canvas": "#F7F8F6",
      "surface": "#FFFFFF",
      "surfaceSunken": "#EEF1EE",
      "surfaceRaised": "#FFFFFF",
      "text": "#18232F",
      "textSecondary": "#596779",
      "textDisabled": "#8C97A3",
      "border": "#DCE3E8",
      "borderStrong": "#B4C0CA",
      "borderInput": "#7D8995",
      "primary": "#174A8B",
      "primaryHover": "#123D73",
      "onPrimary": "#FFFFFF",
      "primarySubtle": "#E7EEF7",
      "onPrimarySubtle": "#123D73",
      "accent": "#E4A33A",
      "onAccent": "#18232F",
      "accentSubtle": "#FBF0DC",
      "onAccentSubtle": "#6E4708",
      "success": "#167A63",
      "onSuccess": "#FFFFFF",
      "successSubtle": "#E2F2ED",
      "onSuccessSubtle": "#0E5545",
      "warning": "#8A5A00",
      "warningSubtle": "#FDF2DD",
      "onWarningSubtle": "#6B4500",
      "error": "#B42318",
      "onError": "#FFFFFF",
      "errorSubtle": "#FCE8E6",
      "onErrorSubtle": "#8F1C13",
      "info": "#174A8B",
      "infoSubtle": "#E7EEF7",
      "focusRing": "#174A8B",
      "scrim": "#0B1218"
    },
    "dark": {
      "canvas": "#0F151B",
      "surface": "#161E26",
      "surfaceSunken": "#0B1116",
      "surfaceRaised": "#1D2731",
      "text": "#E8EDF1",
      "textSecondary": "#A4B1BE",
      "textDisabled": "#6C7986",
      "border": "#2A3642",
      "borderStrong": "#3D4B58",
      "borderInput": "#6E7B88",
      "primary": "#8FB6EC",
      "primaryHover": "#A9C7F1",
      "onPrimary": "#0C2747",
      "primarySubtle": "#1A2D45",
      "onPrimarySubtle": "#C3D8F5",
      "accent": "#F0B85A",
      "onAccent": "#1F1606",
      "accentSubtle": "#33270F",
      "onAccentSubtle": "#F5CF8E",
      "success": "#5CC4A6",
      "onSuccess": "#06241C",
      "successSubtle": "#12302A",
      "onSuccessSubtle": "#8FDCC5",
      "warning": "#E9B65C",
      "warningSubtle": "#33270F",
      "onWarningSubtle": "#F5CF8E",
      "error": "#F2A39C",
      "onError": "#3D0B07",
      "errorSubtle": "#3A1714",
      "onErrorSubtle": "#F7C2BD",
      "info": "#8FB6EC",
      "infoSubtle": "#1A2D45",
      "focusRing": "#8FB6EC",
      "scrim": "#000000"
    },
    "category": {
      "$note": "Small icon tiles and 3px markers only. Never the only signal: always paired with the category name.",
      "ink":   { "light": ["#E7EEF7", "#174A8B"], "dark": ["#1A2D45", "#8FB6EC"] },
      "teal":  { "light": ["#E2F2ED", "#0E5545"], "dark": ["#12302A", "#8FDCC5"] },
      "amber": { "light": ["#FBF0DC", "#6E4708"], "dark": ["#33270F", "#F5CF8E"] },
      "clay":  { "light": ["#F8E9E2", "#7F3418"], "dark": ["#36201A", "#F0B9A3"] },
      "plum":  { "light": ["#F1E8F3", "#5B2C6F"], "dark": ["#2C1F33", "#D9B8E6"] },
      "slate": { "light": ["#EBEFF2", "#384654"], "dark": ["#222C35", "#C2CDD7"] }
    }
  },
  "typography": {
    "familyLatin": "Noto Sans",
    "familyUrdu": "Noto Nastaliq Urdu",
    "numerals": "tabular figures (font-feature tnum) — no separate monospace font",
    "urduLineHeightMultiplier": 1.35,
    "urduSizeDelta": 1,
    "urduLetterSpacing": 0,
    "scale": {
      "display":  { "size": 32, "line": 40, "weight": 700, "tracking": -0.4 },
      "headline": { "size": 24, "line": 32, "weight": 700, "tracking": -0.2 },
      "titleLg":  { "size": 20, "line": 28, "weight": 600, "tracking": 0 },
      "title":    { "size": 17, "line": 24, "weight": 600, "tracking": 0 },
      "bodyLg":   { "size": 16, "line": 24, "weight": 400, "tracking": 0 },
      "body":     { "size": 14, "line": 20, "weight": 400, "tracking": 0 },
      "label":    { "size": 14, "line": 20, "weight": 600, "tracking": 0.1 },
      "labelSm":  { "size": 12, "line": 16, "weight": 600, "tracking": 0.2 },
      "caption":  { "size": 12, "line": 16, "weight": 400, "tracking": 0.1 }
    }
  },
  "space": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64 },
  "layout": {
    "mobileEdge": 20,
    "tabletEdge": 24,
    "adminEdge": 32,
    "formMaxWidth": 560,
    "contentMaxWidth": 1200,
    "adminMaxWidth": 1440,
    "breakpoints": { "compact": 0, "medium": 600, "expanded": 1024, "wide": 1440 }
  },
  "radius": { "xs": 4, "control": 8, "card": 12, "sheet": 20, "full": 999 },
  "border": { "hairline": 1, "strong": 1.5, "focus": 2 },
  "elevation": {
    "$note": "Borders group content. Shadows only for things that float above the page.",
    "none": "none",
    "overlay": "0 4px 16px rgba(11,18,24,0.10), 0 1px 3px rgba(11,18,24,0.08)",
    "sheet": "0 -8px 32px rgba(11,18,24,0.14)"
  },
  "motion": {
    "fast": 120,
    "base": 200,
    "slow": 320,
    "easeStandard": "cubic-bezier(0.2, 0, 0, 1)",
    "easeExit": "cubic-bezier(0.3, 0, 1, 1)",
    "reducedMotion": "durations collapse to 0; no translate/scale"
  },
  "target": { "mobileMin": 48, "adminMin": 40, "iconHit": 44 },
  "icon": { "sm": 16, "md": 20, "lg": 24, "stroke": "Material Symbols Rounded (Flutter) / Lucide 1.75 stroke (web)" }
}
