<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen before Android 12 (Android 12+ uses the splash attributes in
     values-v31/styles.xml). White, with the SkillBridge mark in the centre:
     the same logo, size and background as the app's own splash, so nothing
     changes when the app takes over. The logo comes from
     tool/brand/generate_icons.py. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
