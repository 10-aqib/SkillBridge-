# Copy to `.env` (git-ignored) and fill in. Never commit `.env`.
#
# Used at BUILD time only — `.env` is not bundled into the app:
#   flutter run   --dart-define-from-file=.env
#   flutter build apk --dart-define-from-file=.env
#
# Values passed this way are compiled into the app, so they must be keys that
# are safe in a client app *when restricted*. Never put server secrets here
# (service-account keys, Firebase Admin credentials, payment secrets).

# ── Google Maps ─────────────────────────────────────────────────────────
# Android (and iOS) Maps key. Compiled into the app, so restrict it in
# Google Cloud console → APIs & Services → Credentials:
#   Application restriction: Android apps → package com.skillbridge.skill_bridge
#     + the SHA-1 of every signing key you build with (debug and release).
#   API restriction: Maps SDK for Android only (iOS: a separate key, Maps SDK
#     for iOS, bundle id com.skillbridge.skillBridge, in
#     ios/Flutter/GoogleMaps.local.xcconfig).
# Blank: maps show "Map unavailable"; everything else still works.
GOOGLE_MAPS_API_KEY=
# Web only (emulator testing): a separate key restricted by HTTP referrer
# (e.g. http://localhost:*/*) and to "Maps JavaScript API" only.
GOOGLE_MAPS_WEB_API_KEY=

# ── NADRA fingerprint identity verification ─────────────────────────────
# Not an app setting. The switch (NADRA_BIOMETRIC_ENABLED=false) and the
# other readiness flags live with the Cloud Functions in
# functions/.env.<projectId>, and NADRA credentials (when SkillBridge is ever
# authorised) go only in Google Secret Manager. Never put NADRA credentials or
# any secret in this file: it is compiled into the app.
# See NADRA_INTEGRATION_REQUIREMENTS.md and IDENTITY_VERIFICATION_SETUP_GUIDE.md.

# Firebase App Check — public reCAPTCHA v3 *site* key for the web app
# (Firebase console → App Check → Apps → Web). Needed for web release builds.
RECAPTCHA_V3_SITE_KEY=

# Optional: App Check debug token registered in Firebase console (debug builds).
# Treat as a secret while it is registered.
APP_CHECK_DEBUG_TOKEN=
