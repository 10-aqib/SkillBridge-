# Non-secret settings for Cloud Functions in the production project.
# NADRA fingerprint verification stays OFF until SkillBridge has authorised
# NADRA access, an approved capture SDK/device, credentials in Secret Manager,
# a tested adapter written from NADRA's official documentation, and sandbox
# tests passing. See NADRA_INTEGRATION_REQUIREMENTS.md. Never put secrets here.
NADRA_BIOMETRIC_ENABLED=false
NADRA_ACCESS_APPROVED=false
NADRA_CREDENTIALS_CONFIGURED=false
NADRA_CAPTURE_SDK_APPROVED=false
NADRA_ENVIRONMENT=none
