{
  "name": "skillbridge-rules-tests",
  "private": true,
  "description": "Firestore and Storage security-rules tests, run against the local Firebase emulators. Never touches the real project.",
  "type": "module",
  "scripts": {
    "pretest": "node -e \"const f=require('fs');f.mkdirSync('.rules',{recursive:true});f.copyFileSync('../firestore.rules','.rules/firestore.rules');f.copyFileSync('../storage.rules','.rules/storage.rules')\"",
    "test": "firebase emulators:exec --project demo-skillbridge --only firestore,storage --config firebase.json \"node --test\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.0.0",
    "firebase-tools": "13.35.1"
  }
}
