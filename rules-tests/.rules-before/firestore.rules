rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.role == 'admin' || request.auth.token.role == 'SUPER_ADMIN');
    }
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == 'SUPER_ADMIN';
    }
    function isClient() {
      return isAuthenticated() && currentUserData().role == 'client';
    }
    function isWorker() {
      return isAuthenticated() && currentUserData().role == 'worker';
    }
    
    // ── Validation Helpers ────────────────────────────────────────────────
    function isValidGeoPoint(point) {
      return point != null 
          && point is latlng
          && point.latitude >= -90.0 && point.latitude <= 90.0
          && point.longitude >= -180.0 && point.longitude <= 180.0;
    }
    
    // Checks if the user is updating location fields safely
    function isValidLocationUpdate(data) {
      return !('location' in data) || isValidGeoPoint(data.location);
    }

    function isProtectedProfileDataUnchanged() {
      return (!('role' in request.resource.data) || !('role' in resource.data) || request.resource.data.role == resource.data.role)
        && ((!('isVerified' in request.resource.data) && !('isVerified' in resource.data))
          || (('isVerified' in request.resource.data) && ('isVerified' in resource.data)
            && request.resource.data.isVerified == resource.data.isVerified)
          || (('isVerified' in request.resource.data) && !('isVerified' in resource.data)
            && request.resource.data.isVerified == false))
        && ((!('isCnicVerified' in request.resource.data) && !('isCnicVerified' in resource.data))
          || (('isCnicVerified' in request.resource.data) && ('isCnicVerified' in resource.data)
            && request.resource.data.isCnicVerified == resource.data.isCnicVerified)
          || (('isCnicVerified' in request.resource.data) && !('isCnicVerified' in resource.data)
            && request.resource.data.isCnicVerified == false))
        && ((!('rating' in request.resource.data) && !('rating' in resource.data))
          || (('rating' in request.resource.data) && ('rating' in resource.data)
            && request.resource.data.rating == resource.data.rating)
          || (!('rating' in resource.data)))
        && ((!('totalReviews' in request.resource.data) && !('totalReviews' in resource.data))
          || (('totalReviews' in request.resource.data) && ('totalReviews' in resource.data)
            && request.resource.data.totalReviews == resource.data.totalReviews)
          || (!('totalReviews' in resource.data)))
        && (!('workerProfile' in request.resource.data)
          || ((!('workerProfile' in resource.data)
              && (!('isVerified' in request.resource.data.workerProfile) || request.resource.data.workerProfile.isVerified == false))
            || (('workerProfile' in resource.data)
              && (!('isVerified' in request.resource.data.workerProfile) || !('isVerified' in resource.data.workerProfile) || request.resource.data.workerProfile.isVerified == resource.data.workerProfile.isVerified)
              && (!('averageRating' in request.resource.data.workerProfile) || !('averageRating' in resource.data.workerProfile) || request.resource.data.workerProfile.averageRating == resource.data.workerProfile.averageRating)
              && (!('totalReviews' in request.resource.data.workerProfile) || !('totalReviews' in resource.data.workerProfile) || request.resource.data.workerProfile.totalReviews == resource.data.workerProfile.totalReviews))));
    }

    // ── Users ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if (isOwner(userId) && isValidLocationUpdate(request.resource.data)
                        && isProtectedProfileDataUnchanged()) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Jobs ──────────────────────────────────────────────────────────────
    match /jobs/{jobId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isClient() || isAdmin()) &&
                       request.resource.data.clientId == request.auth.uid &&
                       isValidLocationUpdate(request.resource.data);
      allow update: if isAuthenticated() &&
                       (resource.data.clientId == request.auth.uid || 
                        resource.data.selectedWorkerId == request.auth.uid ||
                        isAdmin()) &&
                       isValidLocationUpdate(request.resource.data);
      allow delete: if isAuthenticated() &&
                       (resource.data.clientId == request.auth.uid || isAdmin());
    }

    // ── Proposals ─────────────────────────────────────────────────────────
    match /proposals/{proposalId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isWorker() &&
                       request.resource.data.workerId == request.auth.uid;
      allow update: if isAuthenticated() &&
                       (resource.data.workerId == request.auth.uid ||
                        resource.data.clientId == request.auth.uid ||
                        isAdmin());
      allow delete: if isAuthenticated() &&
                       (resource.data.workerId == request.auth.uid || isAdmin());
    }

    // ── Contracts ─────────────────────────────────────────────────────────
    match /contracts/{contractId} {
      allow read: if isAuthenticated() &&
                     (resource.data.clientId == request.auth.uid ||
                      resource.data.workerId == request.auth.uid ||
                      isAdmin());
      allow create: if isAuthenticated() &&
                       (request.resource.data.clientId == request.auth.uid ||
                        request.resource.data.workerId == request.auth.uid ||
                        isAdmin()) && request.resource.data.paymentStatus == 'unpaid';
      allow update: if isAuthenticated() &&
                       (resource.data.clientId == request.auth.uid ||
                        resource.data.workerId == request.auth.uid ||
                        isAdmin()) &&
                       (isAdmin() || request.resource.data.paymentStatus == resource.data.paymentStatus);
      allow delete: if isAdmin();
    }

    // ── Reviews ───────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                       (isAdmin() || (
                         request.resource.data.reviewerId == request.auth.uid &&
                         request.resource.data.contractId is string &&
                         reviewId == request.resource.data.contractId + '_' + request.auth.uid &&
                         exists(/databases/$(database)/documents/contracts/$(request.resource.data.contractId)) &&
                         get(/databases/$(database)/documents/contracts/$(request.resource.data.contractId)).data.status == 'completed' &&
                         request.resource.data.isVerifiedCustomer == true &&
                         request.resource.data.rating is number &&
                         request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                         ((get(/databases/$(database)/documents/contracts/$(request.resource.data.contractId)).data.clientId == request.auth.uid &&
                           get(/databases/$(database)/documents/contracts/$(request.resource.data.contractId)).data.workerId == request.resource.data.revieweeId &&
                           get(/databases/$(database)/documents/contracts/$(request.resource.data.contractId)).data.clientReviewed == false) ||
                          (get(/databases/$(database)/documents/contracts/$(request.resource.data.contractId)).data.workerId == request.auth.uid &&
                           get(/databases/$(database)/documents/contracts/$(request.resource.data.contractId)).data.clientId == request.resource.data.revieweeId &&
                           get(/databases/$(database)/documents/contracts/$(request.resource.data.contractId)).data.workerReviewed == false))
                       ));
      allow update: if isAdmin() || (isAuthenticated() &&
                       resource.data.revieweeId == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['workerReply', 'workerReplyAt']));
      allow delete: if isAdmin();
    }

    // ── Chats / Messages ──────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read, write: if isAuthenticated() &&
                            (resource == null ||
                             (resource.data.participantIds != null &&
                              request.auth.uid in resource.data.participantIds) ||
                             isAdmin());

      match /messages/{messageId} {
        allow read, write: if isAuthenticated() &&
                              (get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds != null &&
                               request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds ||
                               isAdmin());
      }
    }

    // ── Categories ────────────────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Notifications ─────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read, update, delete: if isAuthenticated() &&
                                     (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
    }

    // ── FCM Tokens ────────────────────────────────────────────────────────
    match /fcmTokens/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ── User reports ─────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if isAuthenticated()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetUserId is string
        && request.resource.data.targetUserId != request.auth.uid
        && request.resource.data.status == 'open';
      allow read: if isAuthenticated()
        && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
  }
}
